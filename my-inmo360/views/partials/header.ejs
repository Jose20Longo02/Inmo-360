<header class="site-header">
  <div class="header-container">
    <!-- Logo siempre visible -->
    <a href="/" class="logo">
      <img src="/images/inmo360logo.png" alt="INMO360">
    </a>

    <!-- Desktop Navigation: visible en pantallas grandes -->
    <div class="desktop-nav">
      <nav class="main-nav">
        <ul>
          <li><a href="/owners">Propietarios</a></li>
          <li><a href="/agencies">Inmobiliarias</a></li>
          <% if (session.user) { %>
            <li><a href="/properties">Propiedades</a></li>
            <li><a href="/favoritos">Favoritos</a></li>
          <% } %>
        </ul>
      </nav>
      <div class="cta-and-login">
        <% if (session.user) { %>
          <!-- Para usuarios logueados en desktop -->
          <a href="/properties/new" class="cta-button">
             <img src="/images/icons/goal-icon-black.png" alt="Icono de publicar" class="icon">
            Publicar una propiedad
          </a>

          <!-- Botón de notificaciones -->
          <div id="notif-container" class="notif-container">
            <button id="notif-button" class="notif-button" aria-label="Notificaciones">
              <img src="/images/icons/bell-icon.png" alt="Notificaciones" class="bell-icon">
              <span id="notif-badge" class="notif-badge hidden">0</span>
            </button>
            <ul id="notif-dropdown" class="notif-dropdown hidden"></ul>
          </div>

          <div class="user-menu-container">
            <a href="#" class="user-panel-button">
              <img src="<%= session.user.profile_pic %>" alt="Perfil">
            </a>
            <div class="user-dropdown">
              <a href="/dashboard">Editar perfil</a>
              <a href="/logout">Cerrar sesión</a>
            </div>
          </div>
        <% } else { %>
          <!-- Para usuarios no logueados -->
          <a href="/login" class="cta-button">
            <img src="/images/icons/goal-icon-black.png" alt="Icono de publicar" class="icon">
            Anuncia tu propiedad gratis
          </a>
          <a href="/login" class="login-link">
             <img src="/images/icons/user-icon-white.png" alt="Icono de publicar" class="icon">
            Iniciar Sesión
          </a>
        <% } %>
      </div>
    </div>

    <!-- Mobile Header: visible en pantallas pequeñas -->
    <div class="mobile-header">
      <div class="mobile-left">
        <div class="hamburger-menu">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="mobile-right">
        <% if (session.user) { %>
          <a href="/properties/new" class="cta-button">
            <img src="/images/icons/goal-icon-black.png" alt="Icono de publicar" class="icon">
            Publicar propiedad
          </a>
          <!-- Notificaciones en mobile -->
          <div id="notif-container-mobile" class="notif-container">
            <button id="notif-button-mobile" class="notif-button" aria-label="Notificaciones">
              <img src="/images/icons/bell-icon.png" alt="Notificaciones" class="bell-icon">
              <span id="notif-badge-mobile" class="notif-badge hidden">0</span>
            </button>
            <ul id="notif-dropdown-mobile" class="notif-dropdown hidden"></ul>
          </div>
        <% } else { %>
          <a href="/login" class="cta-button">
            <img src="/images/icons/goal-icon-black.png" alt="Icono de publicar" class="icon">
            Anuncia una propiedad
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Desplegable -->
  <nav class="mobile-nav">
    <ul>
      <li><a href="/owners">Propietarios</a></li>
      <li><a href="/agencies">Inmobiliarias</a></li>
      <% if (session.user) { %>
        <li><a href="/properties">Propiedades</a></li>
        <li><a href="/favoritos">Favoritos</a></li>
        <li><a href="/dashboard">Perfil</a></li>
        <li><a href="/logout">Salir</a></li>
      <% } else { %>
        <li><a href="/login" class="login-link">Iniciar Sesión</a></li>
      <% } %>
    </ul>
  </nav>
</header>

<!-- Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Menú hamburguesa en Mobile
    const hamburger = document.querySelector('.hamburger-menu');
    const mobileNav = document.querySelector('.mobile-nav');
    hamburger.addEventListener('click', function() {
      mobileNav.classList.toggle('active');
    });

    // Menú desplegable para el usuario en Desktop
    const userMenuContainer = document.querySelector('.user-menu-container');
    if (userMenuContainer) {
      const userPanelButton = userMenuContainer.querySelector('.user-panel-button');
      const userDropdown = userMenuContainer.querySelector('.user-dropdown');
      userPanelButton.addEventListener('click', function(e) {
        e.preventDefault();
        userDropdown.classList.toggle('active');
      });
      document.addEventListener('click', function(e) {
        if (!userMenuContainer.contains(e.target)) {
          userDropdown.classList.remove('active');
        }
      });
    }
  });
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Elementos de desktop
  const notifBtn    = document.getElementById('notif-button');
  const notifBadge  = document.getElementById('notif-badge');
  const notifDrop   = document.getElementById('notif-dropdown');
  // Elementos de mobile
  const notifBtnM   = document.getElementById('notif-button-mobile');
  const notifBadgeM = document.getElementById('notif-badge-mobile');
  const notifDropM  = document.getElementById('notif-dropdown-mobile');

  let allNotifs = [];

  // Carga inicial de notificaciones
  function loadNotifs() {
    return fetch('/notifications')
      .then(res => res.json())
      .then(items => {
        allNotifs = items;
        const unread = items.filter(n => !n.is_read);
        if (unread.length) {
          notifBadge.textContent  = unread.length;
          notifBadge.classList.remove('hidden');
          notifBadgeM.textContent = unread.length;
          notifBadgeM.classList.remove('hidden');
        }
        const lis = items.map(n =>
          `<li class="${n.is_read ? '' : 'unread'}" data-id="${n.id}">${n.message}</li>`
        ).join('');
        notifDrop.innerHTML  = lis;
        notifDropM.innerHTML = lis;
      });
  }

  // Marca todos como leídos
  function markAllRead() {
    const toMark = allNotifs.filter(n => !n.is_read).map(n => n.id);
    return Promise.all(toMark.map(id =>
      fetch(`/notifications/${id}/read`, { method: 'POST' })
    )).then(() => {
      notifBadge.classList.add('hidden');
      notifBadgeM.classList.add('hidden');
      // actualizar en UI
      notifDrop.querySelectorAll('li.unread').forEach(li => li.classList.remove('unread'));
      notifDropM.querySelectorAll('li.unread').forEach(li => li.classList.remove('unread'));
    });
  }

  // Inicializar
  loadNotifs();

  // Handler abertura desktop
  notifBtn && notifBtn.addEventListener('click', e => {
    e.stopPropagation();
    // marcar y mostrar
    markAllRead().then(() => {
      notifDrop.classList.toggle('hidden');
    });
  });

  // Handler abertura mobile
  notifBtnM && notifBtnM.addEventListener('click', e => {
    e.stopPropagation();
    markAllRead().then(() => {
      notifDropM.classList.toggle('hidden');
    });
  });

  // Cerrar al click fuera
  document.addEventListener('click', () => {
    notifDrop.classList.add('hidden');
    notifDropM.classList.add('hidden');
  });

  // Click en notificación: solo cierra
  [notifDrop, notifDropM].forEach(drop => {
    drop && drop.addEventListener('click', e => {
      const li = e.target.closest('li[data-id]');
      if (!li) return;
      drop.classList.add('hidden');
    });
  });
});
</script>
