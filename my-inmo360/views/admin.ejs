<head>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/header.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Administración</title>
</head>
<%- include('partials/header') %>


<div class="admin-container">
  <h1>Panel de Administración</h1>
  <ul>
    <li>
      <a href="/admin/agencies" class="admin-link">
        Inmobiliarias pendientes
        <% if (pendingAgencies > 0) { %>
          <span class="badge"><%= pendingAgencies %></span>
        <% } %>
      </a>
    </li>
    <li>
      <a href="/admin/properties" class="admin-link">
        Propiedades pendientes
        <% if (pendingProperties > 0) { %>
          <span class="badge"><%= pendingProperties %></span>
        <% } %>
      </a>
    </li>
    <li><a href="/admin/notifications">Historial de notificaciones</a></li>
    <li><a href="/admin/stats/users">Estadísticas de usuarios</a></li>
    <li><a href="/admin/stats/properties">Estadísticas de propiedades</a></li>
    <li><a href="/admin/stats/agencies">Estadísticas de inmobiliarias</a></li>
  </ul>
</div>

<%- include('partials/footer') %>
